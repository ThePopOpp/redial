# Redial environment template. Local development works without provider
# credentials. Never commit real values. For Coolify: set these as runtime
# variables, not build variables.
#
# Variables are grouped by the deployment unit that owns them. The grouping is
# a security boundary, not a formatting choice: see docs/DEVELOPMENT-DEPLOYMENT.md.
# Verify a file before deploying (prints no values): npm run check:launch -- .env.local

# ---------------------------------------------------------------------------
# Web application (Coolify app: redial-web). Browser-safe and perimeter values
# only. This container must never hold a provider secret or a service-role key.
# ---------------------------------------------------------------------------
REDIAL_DEPLOYMENT=development
REDIAL_SITE_URL=https://redial.si
REDIAL_DEV_USERNAME=redial-review
# Generate a unique 32+ character password in your password manager.
REDIAL_DEV_PASSWORD=
REDIAL_DATA_DIR=/app/.redial
NEXT_TELEMETRY_DISABLED=1

# Development Supabase project. Use its sb_publishable_ key, never a secret key.
# Set both values together; otherwise leave both empty.
# Member and staff requests need no service-role key: access is enforced by RLS.
# Apply supabase/migrations in order to a new development project first, then set
# the Supabase Site URL and redirect allowlist to REDIAL_SITE_URL/auth/callback.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Worker application (Coolify app: redial-worker). A SEPARATE deployment unit
# from redial-web, built from services/worker/Dockerfile. It is the only unit
# permitted to hold these values, and npm run check:launch fails the web
# environment if any of them appear there. Do not copy this block into the web
# application's variables.
#
# The worker owns webhook ingress because verifying a Square signature needs the
# signature key. The web tier therefore cannot accept a Square notification at
# all; that is the intended shape, not a gap.
# ---------------------------------------------------------------------------
# SUPABASE_URL=                         # same project as the web application
# SUPABASE_SERVICE_ROLE_KEY=            # secret/service-role key; bypasses RLS
# SQUARE_ACCESS_TOKEN=
# SQUARE_WEBHOOK_SIGNATURE_KEY=
# SQUARE_WEBHOOK_URL=                   # the EXACT configured notification URL;
#                                       # the signature is computed over it
# SQUARE_ENVIRONMENT=sandbox            # sandbox | production
#
# Two independent switches, both off by default. Neither is a formality.
# REDIAL_SQUARE_PRODUCTION_AUTHORIZED=  # must be exactly yes before
#                                       # SQUARE_ENVIRONMENT=production starts
# REDIAL_WORKER_PROVIDER_CALLS=disabled # outbound Square calls. Creating a
#                                       # subscription and sending a refund are
#                                       # NOT IMPLEMENTED; enabling this only
#                                       # makes the worker report that loudly.
#
# Optional, with defaults: PORT=3001, REDIAL_WORKER_ID,
# REDIAL_WORKER_LEASE_SECONDS=60, REDIAL_WORKER_POLL_SECONDS=5.
#
# Still unimplemented and not yet owned by any unit: XAI_API_KEY,
# TWILIO_MESSAGING_SERVICE_SID, and the sending RESEND_API_KEY.

# ---------------------------------------------------------------------------
# Voice gateway (Coolify app: redial-voice). A THIRD deployment unit, built from
# services/voice-gateway/Dockerfile. It is reachable by a Twilio webhook, so it
# has a different exposure profile from both the web app and the worker and does
# not share a container with either. Do not copy this block into redial-web.
#
# Every webhook is signature-checked before a parameter is read. The signed URL
# comes from REDIAL_GATEWAY_ORIGIN, never from forwarded headers: behind Coolify
# a caller controls those and could choose what gets verified.
# ---------------------------------------------------------------------------
# SUPABASE_URL=                          # same project as the web application
# SUPABASE_SERVICE_ROLE_KEY=             # secret/service-role key; bypasses RLS
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=                     # also the webhook signing key
# REDIAL_GATEWAY_ORIGIN=https://voice.redial.si
#
# Two independent switches, both off by default. Neither is a formality.
# REDIAL_GATEWAY_ENVIRONMENT=test        # test | live. test never bridges a call
#                                        # to a real handset, so the webhooks can
#                                        # be exercised before anyone's phone is
#                                        # in the path.
# REDIAL_GATEWAY_BRIDGE_CALLS=disabled   # connecting a screened caller to a real
#                                        # destination. Requires live as well.
#
# Optional: PORT=3002.
#
# Recording is off unless a line sets line_routing.recording_enabled. Assistant
# screening needs line_routing.ai_sip_uri; it is per line, not per deployment, so
# two lines can use different assistants.

# ---------------------------------------------------------------------------
# Read-only provider introspection, used by scripts/check-providers.mjs. These
# enable status checks only; they send nothing and place no calls. Prefer a
# local, git-ignored .env.operator over setting them in Coolify.
# Leave both Twilio values empty to omit it; partial config fails validation.
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Selected development setup: Resend primary, Hostinger SMTP fallback.
# Fill every required credential below before deployment. For a preview without
# email configuration, explicitly set BOTH provider variables to disabled.
# These configure read-only checks; application delivery is not implemented yet.
REDIAL_EMAIL_PROVIDER=resend
REDIAL_EMAIL_FALLBACK_PROVIDER=smtp
EMAIL_FROM=hello@redial.si
RESEND_API_KEY=

# Hostinger outgoing mailbox fallback. Port 465 uses implicit TLS.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# If using port 587, set SMTP_SECURE=false; STARTTLS is still required.

# ---------------------------------------------------------------------------
# Not yet implemented. Incoming-call setup and staging checklist:
# docs/LIVE-LAUNCH-PREPARATION.md. Voice sockets, billing, email delivery and
# retention workers remain separate unverified integrations.
# Legacy name APP_BASE_URL is accepted as a deprecated fallback for
# REDIAL_SITE_URL, as are NEXT_PUBLIC_SUPABASE_URL/PUBLISHABLE_KEY.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Call recordings and transcription (202610020001)
# ---------------------------------------------------------------------------
# Neither is a deployment setting. Both are per line, both need a consent record
# in the database first, and the database refuses the switch without one — the
# backend role included, because a trigger holds where a policy would not.
# See `docs/DECISIONS.md` and the Recording and transcription panel under
# Screening in the dashboard.
#
# Recording playback. The audio stays at Twilio; Redial stores a reference, the
# consent it was captured under and a deletion deadline. Reaching the media
# needs the Twilio account credentials, which belong to the voice gateway, so
# the web application asks the gateway to stream it. Set BOTH on redial-web and
# the same secret on redial-voice, or leave all three empty and playback is
# simply unavailable.
#
# On redial-web:
# REDIAL_VOICE_GATEWAY_URL=https://voice.redial.si   # where to reach the gateway
# REDIAL_MEDIA_ACCESS_SECRET=                        # >= 32 chars, shared with the gateway
#
# On redial-voice:
# REDIAL_MEDIA_ACCESS_SECRET=                        # the same value
#
# On redial-worker, to delete expired audio at the provider. Off by default:
# deletion is irreversible and a provider mutation, so it is a separate
# authorization from everything else the worker does. While it is disabled the
# worker still marks expired recordings and the policies still refuse to serve
# them, so an expired recording is unreadable rather than quietly retained.
# REDIAL_WORKER_MEDIA_DELETION=disabled              # disabled | enabled
# TWILIO_ACCOUNT_SID=                                # required when enabled
# TWILIO_AUTH_TOKEN=                                 # required when enabled
