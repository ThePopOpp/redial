# Local development works without provider credentials. Never commit real values.
# For Coolify: set these as runtime variables (not build variables).
REDIAL_DEPLOYMENT=development
REDIAL_SITE_URL=https://dev.redial.si
REDIAL_DEV_USERNAME=redial-review
# Generate a unique 32+ character password in your password manager.
REDIAL_DEV_PASSWORD=
REDIAL_DATA_DIR=/app/.redial

# Development Supabase project. Use its sb_publishable_ key, never a secret key.
# Set both values together; otherwise leave both empty.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Use a separate development account/subaccount. These only enable read-only checks.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Selected development setup: Resend primary, Hostinger SMTP fallback.
# Fill every required credential below before deployment. For a preview without
# email configuration, explicitly set BOTH provider variables to disabled.
# These configure read-only checks; application delivery is not implemented yet.
REDIAL_EMAIL_PROVIDER=resend
REDIAL_EMAIL_FALLBACK_PROVIDER=smtp
EMAIL_FROM=
RESEND_API_KEY=

# Hostinger outgoing mailbox fallback. Port 465 uses implicit TLS.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# If using port 587, set SMTP_SECURE=false; STARTTLS is still required.
