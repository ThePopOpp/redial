# Redial environment template. Local development works without provider
# credentials. Never commit real values. For Coolify: set these as runtime
# variables, not build variables.
#
# Variables are grouped by the deployment unit that owns them. The grouping is
# a security boundary, not a formatting choice: see docs/DEVELOPMENT-DEPLOYMENT.md.
# Verify a file before deploying (prints no values): npm run check:launch -- .env.local

# ---------------------------------------------------------------------------
# Web application (Coolify app: redial-web). Browser-safe and perimeter values
# only. This container must never hold a provider secret or a service-role key.
# ---------------------------------------------------------------------------
REDIAL_DEPLOYMENT=development
REDIAL_SITE_URL=https://dev.redial.si
REDIAL_DEV_USERNAME=redial-review
# Generate a unique 32+ character password in your password manager.
REDIAL_DEV_PASSWORD=
REDIAL_DATA_DIR=/app/.redial
NEXT_TELEMETRY_DISABLED=1

# Development Supabase project. Use its sb_publishable_ key, never a secret key.
# Set both values together; otherwise leave both empty.
# Member and staff requests need no service-role key: access is enforced by RLS.
# Apply supabase/migrations in order to a new development project first, then set
# the Supabase Site URL and redirect allowlist to REDIAL_SITE_URL/auth/callback.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Worker application (Coolify app: redial-worker). NOT YET IMPLEMENTED — leave
# unset. When it exists it owns Square, message delivery and the service-role
# key, and it is the only unit that may hold them:
#   SQUARE_ACCESS_TOKEN, SQUARE_WEBHOOK_SIGNATURE_KEY, SQUARE_WEBHOOK_URL,
#   SQUARE_ENVIRONMENT, SUPABASE_SERVICE_ROLE_KEY, XAI_API_KEY,
#   TWILIO_MESSAGING_SERVICE_SID, and the sending RESEND_API_KEY.
# npm run check:launch fails if any of those appear in the web environment.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Read-only provider introspection, used by scripts/check-providers.mjs. These
# enable status checks only; they send nothing and place no calls. Prefer a
# local, git-ignored .env.operator over setting them in Coolify.
# Leave both Twilio values empty to omit it; partial config fails validation.
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Selected development setup: Resend primary, Hostinger SMTP fallback.
# Fill every required credential below before deployment. For a preview without
# email configuration, explicitly set BOTH provider variables to disabled.
# These configure read-only checks; application delivery is not implemented yet.
REDIAL_EMAIL_PROVIDER=resend
REDIAL_EMAIL_FALLBACK_PROVIDER=smtp
EMAIL_FROM=
RESEND_API_KEY=

# Hostinger outgoing mailbox fallback. Port 465 uses implicit TLS.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# If using port 587, set SMTP_SECURE=false; STARTTLS is still required.

# ---------------------------------------------------------------------------
# Not yet implemented. Incoming-call setup and staging checklist:
# docs/LIVE-LAUNCH-PREPARATION.md. Voice sockets, billing, email delivery and
# retention workers remain separate unverified integrations.
# Legacy name APP_BASE_URL is accepted as a deprecated fallback for
# REDIAL_SITE_URL, as are NEXT_PUBLIC_SUPABASE_URL/PUBLISHABLE_KEY.
# ---------------------------------------------------------------------------
