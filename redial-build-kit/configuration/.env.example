# Proposed inventory only. Adapt names to the verified implementation.
# Copy to a gitignored environment file; never supply production secrets in prompts.
APP_ENV=development
APP_BASE_URL=http://localhost:3000
PUBLIC_PRODUCTION_DOMAIN=redial.example
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only; exact key model depends on chosen Supabase deployment/version.
SUPABASE_SERVER_SECRET=
DATABASE_URL=
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_VOICE_APP_SID=
VOICE_PUBLIC_HTTPS_URL=
VOICE_PUBLIC_WSS_URL=
XAI_API_KEY=
XAI_VOICE_MODEL=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=
SUPPORT_EMAIL=
# Generate and manage actual encryption material securely outside source control.
CREDENTIAL_ENCRYPTION_KEY_REFERENCE=
# Optional if Redis queue/cache is chosen.
REDIS_URL=
# Default all real outbound/production side effects off in development.
ENABLE_LIVE_VOICE=false
ENABLE_LIVE_BILLING=false
ENABLE_MARKETING_SEND=false
ENABLE_AUTOMATED_OUTBOUND_CALLS=false
ENABLE_CALL_RECORDING=false
ENABLE_CONFERENCE_MONITORING=false
ENABLE_AGENT_EXECUTION=false

# Live Call Controls v1.1 — proposal; not active provider configuration
REDIAL_LIVE_CONTROLS_ENABLED=false
# Separate AI Conference TwiML Application; do not confuse with human SDK app.
TWILIO_AI_CONFERENCE_APP_SID=
